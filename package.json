{
  "name": "fylos-mobile-ui-viewer",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"src/forms/**/*.{ts,tsx}\"",
    "admin:typecheck": "tsc --noEmit -p tsconfig.admin.json",
    "admin:lint": "eslint -c eslint.admin.config.mjs \"src/admin/**/*.{ts,tsx}\"",
    "admin:test": "vitest run -c vitest.admin.config.ts",
    "admin:test:watch": "vitest -c vitest.admin.config.ts",
    "admin:check": "npm run admin:typecheck && npm run admin:lint && npm run admin:test"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.6",
    "@capacitor/ios": "^7.6.6",
    "d3-shape": "^3.2.0",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.300.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.6",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.14.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^9.9.0",
    "eslint-plugin-jsx-a11y": "^6.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.9.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.0.0",
    "vitest": "^2.0.5"
  }
}
